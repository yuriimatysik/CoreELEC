 		if (debug_dolby & 2)
 			pr_dv_dbg
 			("ll_enable=%d,diagnostic=%d,ll_policy=%d\n",
@@ -13673,6 +13728,7 @@ static int amdolby_vision_process_v2_stb
 				 in_size,
 				 in_size_2,
 				 pps_state);
+			s6_dv_trace_setting("apply", vf, &new_m_dovi_setting);
